{
  "name": "@spore-ui/spore-engine-vue2",
  "version": "0.0.0-development",
  "description": "vue2 ssr h5 渲染引擎",
  "main": "./index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon ./kit/serve.js",
    "postpublish": "node ./scripts/update-ynpm.js",
    "serve:prod": "nodemon ./server/entry.js",
    "build": "node ./kit/run-build.js",
    "build:vue": "npm run build:client && npm run build:server",
    "build:client": "vue-cli-service build",
    "build:server": "cross-env WEBPACK_TARGET=node vue-cli-service build --mode server",
    "release": "corp-semantic-release --changelogpreset angular-bitbucket --branch develop",
    "lint": "eslint ./ --fix"
  },
  "dependencies": {
    "@spore-ui/kit": "^1.3.2",
    "@vue/cli-plugin-babel": "^4.5.11",
    "@vue/cli-service": "^4.5.11",
    "autoprefixer": "^9.8.5",
    "chalk": "^3.0.0",
    "colorogger": "^1.3.1",
    "core-js": "^3.6.5",
    "css-loader": "^3.6.0",
    "del": "^6.0.0",
    "execa": "^4.1.0",
    "fs-extra": "^9.0.1",
    "fsevents": "^2.3.2",
    "https-proxy-agent": "^5.0.0",
    "koa": "^2.13.4",
    "koa-favicon": "^2.1.0",
    "koa-static": "^5.0.0",
    "koa-webpack-dev-middleware": "^2.0.2",
    "koa-webpack-hot-middleware": "^1.0.3",
    "less": "^3.11.1",
    "less-loader": "^5.0.0",
    "lodash": "^4.17.20",
    "memfs": "^3.2.0",
    "mitt": "^1.2.0",
    "node-fetch": "^2.6.1",
    "null-loader": "^4.0.1",
    "postcss-flexbugs-fixes": "^4.2.1",
    "postcss-loader": "^3.0.0",
    "postcss-normalize": "^8.0.1",
    "postcss-preset-env": "^6.7.0",
    "qs": "^6.9.4",
    "svg-sprite-loader": "^5.0.0",
    "svg-transform-loader": "^2.0.13",
    "svgo": "^1.3.2",
    "svgo-loader": "^2.2.1",
    "unionfs": "^4.4.0",
    "url-loader": "^4.1.0",
    "vue": "^2.7.16",
    "vue-loader": "^15.9.0",
    "vue-no-ssr": "^1.1.1",
    "vue-router": "^3.4.3",
    "vue-server-renderer": "^2.7.16",
    "vue-style-loader": "^4.1.2",
    "vue-template-compiler": "^2.7.16",
    "vuex": "^3.5.1",
    "webpack": "^4.44.1",
    "webpack-merge": "^4.2.2",
    "whatwg-fetch": "^3.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^8.2.0",
    "@commitlint/config-conventional": "^8.2.0",
    "babel-eslint": "^10.1.0",
    "commitizen": "^4.0.3",
    "commitlint": "^8.2.0",
    "conventional-changelog-angular-bitbucket": "^1.2.0",
    "conventional-changelog-cli": "^2.0.27",
    "corp-semantic-release": "^7.0.0",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.0.2",
    "eslint": "^6.8.0",
    "eslint-plugin-vue": "^6.2.2",
    "husky": "^3.1.0",
    "lint-staged": "^9.4.3",
    "nodemon": "^2.0.6",
    "prettier": "^2.0.5",
    "vue-eslint-parser": "^7.0.0"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "files": [
    "build",
    "lib",
    "server",
    "src",
    "kit",
    "babel.config.js",
    "nodemon.json",
    "index.js",
    "browserslist",
    "vue.config.js"
  ],
  "author": "TabSpace",
  "license": "MIT"
}
